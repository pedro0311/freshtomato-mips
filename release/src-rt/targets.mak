	@$(MAKE) b MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_SIZE=60 LINKSYS_E=y

n60d:
	@$(MAKE) d MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_SIZE=60 LINKSYS_E=y

n60o:
	@$(MAKE) o MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_SIZE=60 LINKSYS_E=y

n60v:
